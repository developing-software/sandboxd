{
  "components": {
    "schemas": {
      "ApproveBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "What the worker printed when it enrolled.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "AttachToken": {
        "additionalProperties": false,
        "properties": {
          "expires_in_s": {
            "format": "int64",
            "type": "integer"
          },
          "token": {
            "type": "string"
          },
          "wss_url": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "wss_url",
          "expires_in_s"
        ],
        "type": "object"
      },
      "Capacity": {
        "additionalProperties": false,
        "properties": {
          "max": {
            "format": "int64",
            "type": "integer"
          },
          "running": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "running",
          "max"
        ],
        "type": "object"
      },
      "CreateSandbox": {
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "description": "Exec'd in the PTY. Omit for the image's default entry.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Persisted, visible in the API.",
            "type": "object"
          },
          "idle_timeout_s": {
            "description": "Ended after this long without PTY traffic. Default 1800.",
            "format": "int64",
            "minimum": 60,
            "type": "integer"
          },
          "image": {
            "examples": [
              "sandboxd-coding-agent:latest"
            ],
            "minLength": 1,
            "type": "string"
          },
          "owner_id": {
            "description": "The parent app's user. Every later call must present the same value.",
            "examples": [
              "user_42"
            ],
            "minLength": 1,
            "type": "string"
          },
          "secret_env": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Forwarded to the worker, never persisted or shown.",
            "type": "object"
          },
          "tags": {
            "description": "Host tags this sandbox requires. Only hosts carrying all of them are candidates.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "owner_id",
          "image"
        ],
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "description": "The first problem, in prose.",
            "type": "string"
          },
          "issues": {
            "description": "Every failing field, for validation errors.",
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HostView": {
        "additionalProperties": false,
        "properties": {
          "approve_code": {
            "description": "Only while pending.",
            "type": "string"
          },
          "capacity": {
            "$ref": "#/components/schemas/Capacity",
            "description": "Only while online."
          },
          "created_at": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "last_seen_at": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "online": {
            "description": "Tunnel connected right now.",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "revoked"
            ],
            "type": "string"
          },
          "tags": {
            "description": "What this host reported in its last hello.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "online",
          "tags",
          "last_seen_at",
          "created_at"
        ],
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Ok": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "OwnerBody": {
        "additionalProperties": false,
        "properties": {
          "owner_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "owner_id"
        ],
        "type": "object"
      },
      "PreviewBody": {
        "additionalProperties": false,
        "properties": {
          "owner_id": {
            "minLength": 1,
            "type": "string"
          },
          "port": {
            "format": "int64",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "owner_id",
          "port"
        ],
        "type": "object"
      },
      "PreviewToken": {
        "additionalProperties": false,
        "properties": {
          "expires_in_s": {
            "format": "int64",
            "type": "integer"
          },
          "token": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "url",
          "expires_in_s"
        ],
        "type": "object"
      },
      "SandboxView": {
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "format": "int64",
            "type": "integer"
          },
          "ended_at": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "ended_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "ended_reason": {
            "enum": [
              "closed",
              "idle",
              "failed",
              "lost",
              "exited",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "host_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "host_online": {
            "description": "Live, not stored.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "id": {
            "examples": [
              "s_ab12cd34"
            ],
            "type": "string"
          },
          "idle_timeout_s": {
            "format": "int64",
            "type": "integer"
          },
          "image": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "queue_position": {
            "description": "1-based, only while queued.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "started_at": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "creating",
              "running",
              "ended"
            ],
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "owner_id",
          "status",
          "host_id",
          "host_online",
          "queue_position",
          "ended_reason",
          "ended_detail",
          "image",
          "cmd",
          "env",
          "tags",
          "idle_timeout_s",
          "created_at",
          "started_at",
          "ended_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Generic sandboxes on your own hosts. Presets, repos and agents are a client concern and reach this API as an image, a command, env and tags.",
    "title": "sandboxd control plane",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/attach": {
      "get": {
        "description": "Browser endpoint. `token` comes from POST /sandboxes/{id}/attach-token. Binary frames are raw PTY bytes both ways; text frames are JSON — the client sends {type:\"resize\",cols,rows}, the server sends {type:\"closed\",reason}.",
        "operationId": "attach",
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Default 120.",
            "in": "query",
            "name": "cols",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Default 40.",
            "in": "query",
            "name": "rows",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket: binary frames are PTY bytes both ways."
          },
          "401": {
            "description": "Invalid or expired attach token."
          }
        },
        "security": [],
        "summary": "Attach to a sandbox terminal",
        "tags": [
          "Service"
        ]
      }
    },
