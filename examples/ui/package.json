{
  "name": "@sandboxd/ui",
  "private": true,
  "description": "The reference client for the sandboxd API: holds the service token, resolves presets, serves the terminal page.",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "start": "bun run src/main.ts",
    "image": "bun run presets/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fallow": "bunx fallow dead-code && bunx fallow dupes"
  },
  "dependencies": {
    "@sandboxd/sdk": "file:../../sdk/typescript",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fallow": "^3.22.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5"
  }
}
