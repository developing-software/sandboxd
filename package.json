{
  "name": "@sandboxd/monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "cp": "bun run apps/cp/src/main.ts",
    "worker": "bun run apps/worker/src/main.ts",
    "dev:cp": "SANDBOXD_DEV=true SANDBOXD_DB=.data/cp.db SANDBOXD_LLM_BASE_URL=${SANDBOXD_LLM_BASE_URL:-https://llm.developing.company} bun run apps/cp/src/main.ts",
    "dev:worker": "SANDBOXD_URL=${SANDBOXD_URL:-ws://localhost:8080} SANDBOXD_WORKER_CONFIG=.data/host.json bun run apps/worker/src/main.ts",
    "image": "bun run presets/build.ts",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fallow": "bunx fallow health --hotspots --top 3 && bunx fallow dead-code && bunx fallow dupes"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fallow": "^3.22.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
