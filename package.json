{
  "name": "devagents",
  "private": true,
  "type": "module",
  "scripts": {
    "cp": "bun run src/cp/main.ts",
    "agent": "bun run src/agent/main.ts",
    "dev:cp": "DEVAGENTS_DEV=true DEVAGENTS_DB=.data/cp.db DEVAGENTS_LLM_BASE_URL=${DEVAGENTS_LLM_BASE_URL:-https://llm.developing.company} bun run src/cp/main.ts",
    "dev:agent": "DEVAGENTS_URL=${DEVAGENTS_URL:-ws://localhost:8080} DEVAGENTS_AGENT_CONFIG=.data/host.json bun run src/agent/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "image": "bun run presets/build.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
